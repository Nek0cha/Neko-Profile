---
import BaseLayout from '../layouts/BaseLayout.astro'
import data from '../data/data.json'
import { Image } from 'astro:assets'
import profileImg from '../assets/profilepicture.jpeg'
import { Icon } from 'astro-icon/components'

const { title, ogp } = data.pages.about
---
<BaseLayout title={title} description={ogp.description}>
  <main class="min-h-screen flex-col items-center px-6 md:px-16">

    <section data-scroll-top class="relative min-h-screen flex items-center px-6 md:px-16">
      <div class="glass-card rounded-xl p-6 md:p-8 max-w-xl w-full">
        <div class="flex items-start gap-4 md:gap-6">
          <Image
            src={profileImg}
            alt="Profile Picture"
            width={80}
            height={80}
            class="rounded-full select-none flex-shrink-0 shadow-xl"
            draggable="false"
          />
          <div>
            <h1 class="text-xl md:text-2xl font-bold text-ink select-none">{data.name}</h1>
            <p class="mt-2 text-sm md:text-base text-ink-sub leading-relaxed select-none">
              {data.bio}
            </p>
          </div>
        </div>

        <div class="mt-6 pt-6 border-t border-white/30 flex gap-3">
          <a
            href="/links"
            draggable="false"
            class="group relative select-none rounded-sm px-4 py-2 text-sm font-medium text-white transition-transform duration-300 hover:scale-105"
          >
            <span class="absolute inset-0 overflow-hidden rounded-sm">
              <span class="absolute inset-0 bg-accent transition-transform duration-300 ease-out group-hover:translate-x-full"></span>
            </span>
            <span class="pointer-events-none absolute inset-0 rounded-sm border border-accent"></span>
            <span class="relative transition-colors duration-300 group-hover:text-accent">Links</span>
          </a>
          <a
            href="/works"
            draggable="false"
            class="group relative select-none rounded-sm px-4 py-2 text-sm font-medium text-accent transition-transform duration-300 hover:scale-105"
          >
            <span class="absolute inset-0 overflow-hidden rounded-sm">
              <span class="absolute inset-0 -translate-x-full bg-accent transition-transform duration-300 ease-out group-hover:translate-x-0"></span>
            </span>
            <span class="pointer-events-none absolute inset-0 rounded-sm border border-accent"></span>
            <span class="relative transition-colors duration-300 group-hover:text-white">Works</span>
          </a>
        </div>
      </div>

      <div
        class="pointer-events-none absolute inset-x-0 bottom-8 flex select-none flex-col items-center gap-1 text-ink-sub transition-opacity duration-300"
        style="opacity: calc(1 - var(--scroll-progress) * 5)"
      >
        <Icon name="ri:arrow-down-line" class="w-4 h-4 animate-bounce" />
      </div>
    </section>

    <section data-scroll-middle class="relative min-h-[calc(100vh_-_var(--footer-h))] flex items-center px-6 md:px-16">
      <div class="absolute -inset-x-6 md:-inset-x-16 inset-y-0 -z-10 bg-black/20"></div>
    
      <div class="glass-card rounded-xl p-8 md:p-12 max-w-2xl w-full">
        <span class="text-xs tracking-widest text-ink-sub uppercase">About</span>
        <h2 class="text-2xl md:text-3xl font-bold text-ink mt-2">自己紹介</h2>
        <div class="mt-6 text-sm md:text-base text-ink-sub leading-relaxed space-y-2">
          {data.detailedBio.map((line) => <p>{line}</p>)}
        </div>
      </div>
    </section>

  </main>
</BaseLayout>