---
import BaseLayout from '../layouts/BaseLayout.astro'
import profile from '../data/profile.json'
---
<BaseLayout title={profile.name}>
  <h1>{profile.name}</h1>
  <p>{profile.title}</p>
  <p>{profile.bio}</p>
  <ul>
    {profile.links.map((link) => (
      <li><a href={link.url}>{link.label}</a></li>
    ))}
  </ul>
</BaseLayout>