---
import BaseLayout from '../layouts/BaseLayout.astro'
import data from '../data/data.json'

const { title, message, ogp } = data.pages.nekochan
---
<BaseLayout title={title} description={ogp.description} image={ogp.image} noindex>
  <main class="min-h-[calc(100vh_-_var(--footer-h))] flex items-center justify-center px-6 md:px-16">
    <div class="glass-card flex w-full max-w-md flex-col items-center gap-4 rounded-xl p-8 md:p-12">
      <pre class="select-none text-sm leading-tight text-ink md:text-base">
⠀　　　　　　＿＿
　　　　　／＞　　フ
　　　　　| 　_　 _彡
　 　　　／`ミ＿xノ
　　 　 /　　　 　 |
　　　 /　 ヽ　　 ﾉ
　 　 │　　|　|　|
　／￣|　　 |　|　|
　| (￣ヽ＿_ヽ_)__)
　＼二つ
      </pre>
      <p class="select-none text-center text-sm text-ink-sub md:text-base">{message}</p>
    </div>
  </main>
</BaseLayout>
