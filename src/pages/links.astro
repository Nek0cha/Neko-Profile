---
import BaseLayout from '../layouts/BaseLayout.astro'
import data from '../data/data.json'
import { Icon } from 'astro-icon/components'

const { title, ogp } = data.pages.links
---
<BaseLayout title={title} description={ogp.description}>
  <main class="min-h-[calc(100vh_-_var(--footer-h))] flex items-center px-6 md:px-16 py-24">
    <div class="glass-card rounded-xl p-8 max-w-xl w-full">
      <span class="text-xs tracking-widest text-ink-sub uppercase">Links</span>
      <h1 class="text-2xl font-bold text-ink mt-2 mb-6">SNSリンク</h1>

      <ul class="space-y-3">
        {data.links.map((link) => {
          const email = link.url.startsWith('mailto:') ? link.url.replace('mailto:', '') : null
          return (
            <li>
              {email ? (
                <button
                  type="button"
                  data-copy-email={email}
                  style={`--theme-color: ${link.themeColor}`}
                  class="copy-btn group flex w-full items-center gap-3 rounded-sm p-3 text-left transition-colors hover:bg-white/15 cursor-pointer"
                >
                  <span class="relative w-5 h-5 shrink-0">
                    <Icon name={link.icon} class="copy-icon-default w-5 h-5 text-ink transition-colors group-hover:text-[var(--theme-color)]" />
                    <Icon name="ri:check-line" class="copy-icon-copied hidden absolute inset-0 w-5 h-5 text-accent" />
                  </span>
                  <span class="flex items-baseline gap-2">
                    <span class="text-sm font-medium text-ink transition-colors group-hover:text-[var(--theme-color)]">{link.title}</span>
                    <span class="copy-handle text-xs text-ink-sub" data-handle={link.handle}>{link.handle}</span>
                  </span>
                  {link.description && (
                    <span class="ml-auto max-w-[40%] truncate pl-3 text-right text-xs text-ink-sub">{link.description}</span>
                  )}
                </button>
              ) : (
                <a
                  href={link.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  style={`--theme-color: ${link.themeColor}`}
                  class="group flex items-center gap-3 p-3 rounded-sm transition-colors hover:bg-white/15"
                >
                  <Icon name={link.icon} class="w-5 h-5 text-ink transition-colors group-hover:text-[var(--theme-color)]" />
                  <span class="flex items-baseline gap-2">
                    <span class="text-sm font-medium text-ink transition-colors group-hover:text-[var(--theme-color)]">{link.title}</span>
                    <span class="text-xs text-ink-sub">{link.handle}</span>
                  </span>
                  {link.description && (
                    <span class="ml-auto max-w-[40%] truncate pl-3 text-right text-xs text-ink-sub">{link.description}</span>
                  )}
                </a>
              )}
            </li>
          )
        })}
      </ul>
    </div>
  </main>
  <script>
    import '../scripts/copy-email.ts'
  </script>
</BaseLayout>
